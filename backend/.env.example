# LLM
LLM_API_KEY=
LLM_PROVIDER=mock

# Database
DATABASE_URL=postgresql+psycopg2://consight:consight@localhost:5432/consight

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# WhatsApp Business Cloud API
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# PMIS Push (Primavera P6 / MS Project)
# Set PMIS_PUSH_ENDPOINT_URL to enable automatic push on auto-commit.
# If not set, falls back to local stub endpoint at /pmis/stub/push
PMIS_PUSH_ENDPOINT_URL=
PMIS_PUSH_API_KEY=
PMIS_PUSH_TIMEOUT_SECONDS=30
PMIS_PUSH_MAX_RETRIES=3
PMIS_PUSH_RETRY_BACKOFF_SECONDS=2